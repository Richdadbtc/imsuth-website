DJANGO_ENV=production
DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=paypoint.imsuth.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://paypoint.imsuth.org
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=imsuth_paypoint
POSTGRES_USER=imsuth_paypoint
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_SSLMODE=prefer
REDIS_URL=redis://redis:6379/0
PAYPOINT_URL_PREFIX=/paypoint
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
PAYMENT_TEST_MODE=false
TEST_WEBHOOK_SECRET=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@imsuth.org
EMAIL_HOST=replace-with-approved-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# Enable only after SMTP and the approved hostname are configured.
PASSWORD_RECOVERY_URL=
