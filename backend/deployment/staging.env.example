DJANGO_ENV=staging
DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=staging-paypoint.imsuth.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging-paypoint.imsuth.org
POSTGRES_DB=imsuth_paypoint_staging
POSTGRES_USER=imsuth_paypoint
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
REDIS_URL=redis://redis:6379/0
PAYPOINT_URL_PREFIX=/paypoint
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
PAYMENT_TEST_MODE=true
TEST_WEBHOOK_SECRET_FILE=/run/secrets/test_webhook_secret
CELERY_TASK_ALWAYS_EAGER=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=paypoint-staging@imsuth.org
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO

# Enable recovery only after approved SMTP delivery is configured.
PASSWORD_RECOVERY_URL=
